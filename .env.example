# ============================================================
# Smart Knowledge Assistant — environment configuration template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- General ---
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO

# --- PostgreSQL (conversations, messages, app metadata) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_assistant
DATABASE_URL=postgresql+psycopg://rag_user:change-me@localhost:5432/rag_assistant

# --- Qdrant (vector database, Phase 3) ---
# Qdrant Server via Docker Compose (infrastructure/docker/docker-compose.yml):
# HTTP API / Web UI on 6333, gRPC on 6334; persistent storage in data/qdrant-server/.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docs_chunks

# --- Embeddings (Phase 3) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
# NOTE: E5 models require "query: " / "passage: " prefixes; handled in code.

# --- LLM via LiteLLM (initial provider: Groq) ---
GROQ_API_KEY=
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# --- Langfuse (tracing: latency, token usage, pipeline traces) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Controlled scraper (Phase 2) ---
SCRAPE_USER_AGENT=RAGAssistantBot/0.1 (contact: your-email@example.com)
SCRAPE_MAX_DEPTH=3
SCRAPE_MAX_PAGES=500
SCRAPE_REQUEST_DELAY_SECONDS=1.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
