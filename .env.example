# ============================================================
# Smart Knowledge Assistant — environment configuration template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

# --- General ---
APP_ENV=development                 # development | staging | production
LOG_LEVEL=INFO

# --- PostgreSQL (conversation history, Phase 6) ---
# Docker Compose service (infrastructure/docker/docker-compose.yml):
#   docker compose -f infrastructure/docker/docker-compose.yml up -d postgres
# POSTGRES_* values must match the compose service env + DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag_assistant
DATABASE_URL=postgresql+psycopg://rag_user:change-me@localhost:5432/rag_assistant
CONVERSATION_HISTORY_WINDOW=10

# --- Qdrant (vector database, Phase 3) ---
# Qdrant Server via Docker Compose (infrastructure/docker/docker-compose.yml):
# HTTP API / Web UI on 6333, gRPC on 6334; persistent storage in data/qdrant-server/.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docs_chunks

# --- Embeddings (Phase 3) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32
# NOTE: E5 models require "query: " / "passage: " prefixes; handled in code.

# --- Cross-Encoder reranker (Phase 5) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# --- Query rewriting / LLM via LiteLLM (initial provider: Groq, Phase 6) ---
GROQ_API_KEY=
LLM_MODEL=groq/llama-3.3-70b-versatile

# --- Retrieval reliability (Phase 10) ---
# Cross-Encoder score thresholds (calibrated on the real logits of
# cross-encoder/ms-marco-MiniLM-L-6-v2):
#   top score >= RETRIEVAL_RELEVANT_THRESHOLD -> RELEVANT
#   top score >= RETRIEVAL_PARTIAL_THRESHOLD  -> PARTIALLY_RELEVANT
#   otherwise                                  -> IRRELEVANT (abstain, or try
#                                                one corrective retrieval)
RETRIEVAL_RELEVANT_THRESHOLD=2.0
RETRIEVAL_PARTIAL_THRESHOLD=-3.0
# One corrective retrieval attempt (lightweight CRAG) when the first
# retrieval is judged irrelevant.
CRAG_CORRECTION_ENABLED=true

# --- RAGAS evaluation (Phase 9.1) ---
# Judge model for the evaluation metrics; falls back to LLM_MODEL when unset.
# Verified stable judge on this dataset: qwen/qwen3.8-27b (see docs/EVALUATION.md).
EVALUATOR_MODEL=groq/qwen/qwen3.8-27b
EVALUATOR_TEMPERATURE=0.0

# --- Langfuse (tracing: latency, token usage, pipeline traces) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Controlled scraper (Phase 2) ---
SCRAPE_USER_AGENT=RAGAssistantBot/0.1 (contact: your-email@example.com)
SCRAPE_MAX_DEPTH=3
SCRAPE_MAX_PAGES=500
SCRAPE_REQUEST_DELAY_SECONDS=1.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
